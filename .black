# команда запуска black: black --config ./.black .

# Максимальная длина строки
line-length = 79

# Файлы, которые не нужно форматировать
exclude = '''
(
  /(
      \.eggs         # Исключить несколько общих каталогов
    | \.git          # в корне проекта
    | \.hg
    | \.mypy_cache
    | \.tox
    | \.venv
    | \venv
    | dist
  )/
  | manage.py           # Также отдельно исключить файл с именем manage.py
  | .gitignore          # в корне проекта
)
'''